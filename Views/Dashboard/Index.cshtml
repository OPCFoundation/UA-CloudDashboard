@{
    ViewData["Title"] = "Partners";

    // Name is posted as the form key and mapped to an MQTT topic in DashboardController.Display
    var partners = new (string Name, string Logo)[]
    {
        ("Beckhoff", "Beckhoff_Logo.png"),
        ("KUKA", "KUKA.png"),
        ("Matrikon", "matrikon.png"),
        ("Mettler Toledo", "mettlertoledo.png"),
        ("Phoenix Contact", "phoenix-contact.png"),
        ("Pilz", "pilz.jpg"),
        ("Prosys OPC", "prosys.png"),
        ("Siemens", "siemens.png"),
        ("Trumpf", "trumpf.jpg"),
        ("Unified Automation", "ualogo.png"),
        ("VDW", "vdw.png"),
        ("Wago", "wago.jpg"),
        ("OPC Foundation", "opcf.jpg"),
        ("2mag", "2mag_logo.png"),
        ("Agilent", "Agilent_Logo.png"),
        ("Byonoy", "Byonoy_Logo.png"),
        ("FHI", "FHI.png"),
        ("Gambica", "gambica_logo.png"),
        ("Infoteam", "infoteam_2x_4c_rgb_Logo.png"),
        ("Integris", "INTEGRIS LIMS_Logo.png"),
        ("Julabo", "JULABO_LOGO_bei_Einsatz_mit_weisem_Hintergrund.png"),
        ("Alresa", "Logoeslogan.jpg"),
        ("Spectaris", "SPECTARIS_Dachmarke_CMYK.jpg"),
        ("Amensio", "amensio.png"),
        ("Brand", "brand.png"),
        ("Essentim", "essentim.png"),
        ("Labforward", "labforward.png"),
        ("InforsHT", "inforsht.png"),
        ("Labmas", "labmas.png"),
        ("Lads", "lads.png"),
        ("Jaima", "JAIMA.png"),
        ("Berthold", "Berthold.jpg"),
        ("Gefran", "Gefran.png"),
        ("Microsoft", "microsoft.png"),
        ("Schneider", "schneider.png"),
        ("Inray", "inray.png"),
        ("Samson", "samson.png"),
    };
}

<div class="page-header">
    <div>
        <h1>OPC UA over MQTT Collaboration Partners</h1>
        <p class="page-subtitle mb-0">
            Select a partner to subscribe to its OPC UA PubSub telemetry and watch the data arrive live.
            The OPC Foundation tile subscribes to all published topics.
        </p>
    </div>
    <div class="page-header-meta">
        <span class="meta-chip"><span class="meta-chip-value">@partners.Length</span> partners</span>
        <span class="meta-chip">OPC UA PubSub</span>
    </div>
</div>

<div class="toolbar">
    <div class="search-box">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85zm-5.242.656a5 5 0 1 1 0-10 5 5 0 0 1 0 10z" /></svg>
        <input id="partnerSearch" type="search" class="form-control" placeholder="Search partners..." aria-label="Search partners" autocomplete="off" />
    </div>
    <span id="partnerCount" class="toolbar-hint">Showing @partners.Length of @partners.Length</span>
</div>

<form action="/Dashboard/Display" method="post">
    <div class="partner-grid">
        @foreach (var partner in partners.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase))
        {
            <button type="submit" class="partner-tile" name="@partner.Name" value="Display" data-partner="@partner.Name.ToLowerInvariant()" title="Display live telemetry from @partner.Name">
                <span class="partner-logo">
                    <img src="~/@partner.Logo" alt="@partner.Name logo" loading="lazy" />
                </span>
                <span class="partner-footer">
                    <span class="partner-name">@partner.Name</span>
                    <span class="partner-action">View live data &rsaquo;</span>
                </span>
            </button>
        }
    </div>
    <div id="partnerEmpty" class="empty-state d-none">No partners match your search.</div>
</form>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('partnerSearch');
            var tiles = document.querySelectorAll('.partner-tile');
            var count = document.getElementById('partnerCount');
            var empty = document.getElementById('partnerEmpty');

            input.addEventListener('input', function () {
                var term = input.value.trim().toLowerCase();
                var visible = 0;
                tiles.forEach(function (tile) {
                    var match = tile.getAttribute('data-partner').indexOf(term) !== -1;
                    tile.classList.toggle('d-none', !match);
                    if (match) {
                        visible++;
                    }
                });
                count.textContent = 'Showing ' + visible + ' of ' + tiles.length;
                empty.classList.toggle('d-none', visible !== 0);
            });
        })();
    </script>
}
